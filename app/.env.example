# ============================================================================================
# Eternal — konfiguracja (skopiuj do .env). Wartości puste = funkcja wyłączona lub domyślna.
# Na serwerze plik tworzy i uzupełnia instalator: ./deploy/eternal.sh install (docs/WDROZENIE_SERWER.md).
# Po zmianie wartości: ./deploy/eternal.sh restart, sprawdzenie: ./deploy/eternal.sh check
# ============================================================================================

# --- serwer (Docker Compose) ---
COMPOSE_PROJECT_NAME=eternal
# pokaz (dane fikcyjne): docker-compose.yml:docker-compose.demo.yml · pilotaż: docker-compose.yml
COMPOSE_FILE=docker-compose.yml
# domena dla certyfikatu HTTPS (Caddy); bez domeny: <adres-ip-z-myślnikami>.sslip.io
ETERNAL_DOMAIN=
# obraz aplikacji: budowany lokalnie albo gotowy z rejestru (wtedy install --no-build)
ETERNAL_IMAGE=eternal:local
# hasło szyfrowania kopii zapasowych (./deploy/eternal.sh backup) — przechowuj też poza serwerem
BACKUP_PASSPHRASE=

# --- podstawowe ---
NODE_ENV=production
PORT=3000
PUBLIC_URL=https://pacjent.twoja-placowka.pl
DATA_DIR=./data
TRUST_PROXY=true
# true wyłącznie w instancjach prezentacyjnych (baner „dane fikcyjne”, seed demo)
DEMO_MODE=false
# z DEMO_MODE=true: dane fikcyjne tworzone przy pierwszym starcie, gdy baza jest pusta
DEMO_SEED_ON_START=false
CLINIC_TIMEZONE=Europe/Warsaw

# --- bezpieczeństwo ---
# Klucz HMAC łańcucha dziennika zdarzeń (min. 32 losowe znaki) — przechowuj w menedżerze sekretów.
AUDIT_HMAC_KEY=
PATIENT_IDLE_MINUTES=30
STAFF_IDLE_MINUTES=15
SESSION_ABSOLUTE_HOURS=12
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15
MIN_PASSWORD_LENGTH=10
REQUIRE_EMAIL_VERIFICATION=true

# --- repozytorium danych klinicznych (HL7 FHIR R4) ---
# local   — wbudowany magazyn FHIR na SQLite (z historią wersji)
# medplum — Medplum (chmura lub instancja własna), ClientApplication z client credentials
# fhir    — dowolny serwer FHIR R4 (HAPI, Azure Health Data Services, Google Healthcare API, Aidbox…)
FHIR_BACKEND=local
MEDPLUM_BASE_URL=https://api.medplum.com/
MEDPLUM_CLIENT_ID=
MEDPLUM_CLIENT_SECRET=
FHIR_BASE_URL=
FHIR_AUTH_TOKEN=
FHIR_TOKEN_URL=
FHIR_CLIENT_ID=
FHIR_CLIENT_SECRET=

# --- polityka placówki ---
CANCEL_MIN_HOURS=12
REMINDER_OFFSETS_HOURS=24,2

# --- e-mail (dowolny SMTP, np. smtps://uzytkownik:haslo@smtp.dostawca.pl:465) ---
SMTP_URL=
MAIL_FROM=Przychodnia <no-reply@twoja-placowka.pl>

# --- SMS (opcjonalnie, płatne) ---
# smsapi — SMSAPI.pl (token OAuth), webhook — własna bramka przyjmująca POST {to, message, sender}
SMS_PROVIDER=
SMSAPI_TOKEN=
SMS_SENDER=Eternal
SMS_WEBHOOK_URL=

# --- Web Push (VAPID) — puste = klucze generowane automatycznie i zapisane w bazie ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:it@twoja-placowka.pl

# --- teleporady (Jitsi Meet) — produkcyjnie własna instancja w EOG z uwierzytelnianiem JWT ---
JITSI_DOMAIN=meet.twoja-placowka.pl
JITSI_APP_ID=
JITSI_APP_SECRET=

# --- urządzenia: Withings (bezpłatne konto deweloperskie) ---
# adres zwrotny do zarejestrowania: {PUBLIC_URL}/api/integrations/withings/callback
WITHINGS_CLIENT_ID=
WITHINGS_CLIENT_SECRET=

# --- platformy zdalnego monitorowania (RPM), np. Vitalera — webhook FHIR podpisany HMAC ---
# format: dostawca:sekret[,dostawca2:sekret2]; adres: {PUBLIC_URL}/api/integrations/rpm/{dostawca}/webhook
RPM_WEBHOOK_SECRETS=

# --- terminologie ---
# WHO ICD-11 API (bezpłatna rejestracja: https://icd.who.int/icdapi)
ICD11_CLIENT_ID=
ICD11_CLIENT_SECRET=
ICD11_RELEASE=2025-01

# --- publiczne API bez klucza (można wyłączyć, np. w sieci bez dostępu do internetu) ---
NFZ_API_ENABLED=true
NLM_API_ENABLED=true
HIBP_ENABLED=true
# Open Food Facts (dziennik żywienia), GIOŚ (jakość powietrza), IMGW (pogoda)
OFF_API_ENABLED=true
GIOS_API_ENABLED=true
IMGW_API_ENABLED=true
PUBLIC_API_TIMEOUT_MS=8000

# --- bezpieczeństwo (R8) ---
# adres zgłoszeń podatności (security.txt) i incydentów bezpieczeństwa
SECURITY_CONTACT=security@twoja-placowka.pl
# najwięcej jednocześnie zalogowanych urządzeń pacjenta (F1.13)
MAX_DEVICES=5
# rotacja kopii zapasowych w dniach — podawana pacjentowi w potwierdzeniu usunięcia danych (A18.12)
BACKUP_RETENTION_DAYS=35
# zgłoszenia błędów serwera do Sentry w regionie UE (bez treści i identyfikatorów); puste = wyłączone
SENTRY_DSN=
# true pozwala na projekt Sentry poza UE (domyślnie odrzucany)
SENTRY_ALLOW_NON_EU=false
APP_VERSION=

# --- logowanie firmowe / zewnętrzna usługa tożsamości (D50): Cognito, Keycloak, Entra — OIDC z PKCE ---
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_LABEL=Logowanie firmowe
WEBAUTHN_RP_NAME=Eternal

# --- brama modeli AI (R5) ---
# bedrock (Claude w AWS, region UE) | anthropic | demo (reguły, tylko DEMO_MODE) | none
AI_PROVIDER=none
# AI_PROVIDER=anthropic — klucz z console.anthropic.com
ANTHROPIC_API_KEY=
# AI_PROVIDER=bedrock oraz OCR_PROVIDER=textract — użytkownik IAM (albo rola serwera) w regionie UE
AWS_REGION=eu-central-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
# puste = domyślne modele bramki (server/config.ts)
AI_MODEL_NOTE=
AI_MODEL_FAST=
# ponowienie odmowy modelu na innym modelu
AI_REFUSAL_FALLBACK=true
AI_FALLBACK_MODEL_NOTE=
AI_FALLBACK_MODEL_FAST=
# zapas przy awarii dostawcy podstawowego
AI_SECONDARY_PROVIDER=
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-medium-latest
AI_DAILY_CALL_LIMIT_PER_ORG=3000

# --- odczyt dokumentów (D51): pdf.js lokalnie, potem mistral | google | textract ---
OCR_PROVIDER=
MISTRAL_OCR_MODEL=mistral-ocr-latest
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_DOCAI_PROJECT=
GOOGLE_DOCAI_LOCATION=eu
GOOGLE_DOCAI_PROCESSOR=

# --- mowa na tekst dla Scribe (D48): elevenlabs | azure | openai — wyłącznie z przetwarzaniem w UE ---
STT_PROVIDER=
ELEVENLABS_API_KEY=
ELEVENLABS_BASE_URL=https://api.eu.residency.elevenlabs.io
ELEVENLABS_STT_MODEL=scribe_v2_medical
# on = słownik leków i badań placówki (dodatkowo płatny); zero retencji — plany firmowe
ELEVENLABS_KEYTERMS=off
ELEVENLABS_ZERO_RETENTION=off
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=westeurope
OPENAI_API_KEY=
OPENAI_BASE_URL=https://eu.api.openai.com/v1
OPENAI_STT_MODEL=gpt-4o-transcribe

# --- wideo (D52): whereby | jitsi ---
VIDEO_PROVIDER=jitsi
WHEREBY_API_KEY=
WHEREBY_REGION=eu-central-1

# --- partnerzy (API, wyłącznie po stronie serwera) ---
# Validic Inform — dane z urządzeń pacjenta
VALIDIC_ORG_ID=
VALIDIC_TOKEN=
VALIDIC_BASE_URL=https://api.v2.validic.com
# ZnanyLekarz / Docplanner Integrations API — terminy i rezerwacje (klienci Docplanner)
DOCPLANNER_DOMAIN=https://www.znanylekarz.pl
DOCPLANNER_CLIENT_ID=
DOCPLANNER_CLIENT_SECRET=
# Infermedica — wyrób medyczny; aktywny dopiero po wpisaniu oceny zgodności MDR w panelu administratora
INFERMEDICA_APP_ID=
INFERMEDICA_APP_KEY=
INFERMEDICA_BASE_URL=https://api.infermedica.com/v3
INFERMEDICA_MODEL=
# licencjonowana przeglądarka 3D badań obrazowych placówki: adres z {patientId} albo {eternalId}
IMAGING_VIEWER_URL=
IMAGING_VIEWER_NAME=przeglądarka 3D

# --- raporty PDF (Chromium) — w obrazie Docker ustawione; poza Dockerem odkomentuj, jeśli nie jest wykrywany ---
# CHROMIUM_PATH=/usr/bin/chromium

# --- aplikacja mobilna (A18.7): starsze wersje widzą ekran „Wymagana aktualizacja” ---
MOBILE_MIN_VERSION=1.0.0
MOBILE_LATEST_VERSION=1.0.0
MOBILE_IOS_STORE_URL=
MOBILE_ANDROID_STORE_URL=
